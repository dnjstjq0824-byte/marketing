# 빌드 산출물·생성 파일은 커밋하지 않는다 (§12)
web/dist/
web/node_modules/
backend/somun
backend/somun.exe
backend/*.exe
backend/*.exe~
backend/*.test

# 로컬 데이터 (DB·업로드·백업). 프롬프트는 버전 관리 대상이라 예외다.
data/*
!data/prompts/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.pyc
.venv/

# 상주 러너 (에이전트 토큰 포함, 로컬 전용)
scripts/workers/

# 환경·에디터
.env
.DS_Store
.idea/
.vscode/

# 작업자 실행 로그 (로컬 전용)
worker/*.log
